# Copy to .env before running the stack: cp .env.example .env

# --- PostgreSQL container -------------------------------------------------
POSTGRES_USER=finora
POSTGRES_PASSWORD=finora
POSTGRES_DB=finora
# Host port the database is published on. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# --- Application ----------------------------------------------------------
# Host port the application is published on.
APP_PORT=3000

# Connection string used by Prisma.
#   - inside Docker the host is the compose service name `db`
#   - outside Docker use `localhost:${POSTGRES_PORT}`
DATABASE_URL=postgresql://finora:finora@localhost:5432/finora?schema=public
