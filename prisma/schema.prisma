// Finora database schema.
//
// Conventions that apply to every model added in later sprints:
//
//   Money  — stored as BigInt holding whole Rial, never Float or Decimal
//            (rule G.2). Displayed in Toman at the presentation layer.
//   Dates  — stored as DateTime in UTC. Jalali values are a display concern
//            and never reach the database (rule G.5).
//   Ids    — cuid(), so identifiers can be generated client-side without a
//            round trip and carry no ordering information.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application-level key/value settings.
///
/// This is deliberately the only model in Sprint 0: the sprint's goal is a
/// working foundation with no financial business logic, but a migration needs
/// something to create in order to prove the pipeline end to end. The domain
/// models (Account, Transaction, Category, ...) arrive in Sprint 1.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Who a financial record belongs to.
///
/// The household is two people plus everything they share, so ownership is a
/// fixed set rather than a user table: Finora is a self-hosted deployment for
/// one household (see docs/ARCHITECTURE.md). Sprint 7 builds the household
/// views on top of this.
enum Owner {
  SHARED
  REZA
  YEGANEH
}

enum AccountType {
  BANK
  CASH
  WALLET
  INVESTMENT
  BUSINESS
  OTHER
}

/// A place money sits: a bank account, cash, a wallet, a business account.
///
/// There is deliberately no `balance` column. A stored balance is a second
/// source of truth that drifts the moment a transaction is edited, deleted or
/// back-dated, and reconciling it is a class of bug this application cannot
/// afford. The current balance is derived as
///
///     initialBalance + sum(transactions affecting this account)
///
/// which is always correct by construction.
model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType
  owner          Owner
  /// ISO 4217 code. Only IRR is supported: all monetary values in the
  /// application are Rial, and mixing currencies would make household totals
  /// silently wrong. Foreign holdings are modelled as assets in Sprint 3.
  currency       String      @default("IRR")
  /// Opening balance in whole Rial (rule G.2). May be negative, for an
  /// account that was already overdrawn when it was added.
  initialBalance BigInt      @default(0)
  /// Archived accounts keep their history but are hidden from active lists
  /// and cannot receive new transactions.
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  /// Income, expenses, and transfers *out of* this account.
  transactions      Transaction[] @relation("TransactionAccount")
  /// Transfers *into* this account.
  incomingTransfers Transaction[] @relation("TransactionToAccount")

  @@index([isActive])
  @@index([owner])
  @@map("accounts")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

/// A movement of money.
///
/// Each type uses the account fields differently:
///
///   INCOME    accountId receives the amount.       toAccountId is null.
///   EXPENSE   accountId pays the amount.           toAccountId is null.
///   TRANSFER  accountId pays, toAccountId receives. Both are required.
///
/// A transfer is one row rather than a matched pair of expense and income
/// rows. A pair can be half-deleted or half-edited, and every aggregate then
/// has to remember to exclude both halves or it double-counts household
/// spending — exactly what rule G.3 forbids. One row cannot fall out of step
/// with itself.
///
/// The invariants are enforced by database CHECK constraints as well as by
/// the API, so a bad row cannot be written by any path: amounts are always
/// positive (rule G.2 keeps the sign in `type`, never in the number), a
/// transfer always has a destination that differs from its source, and a
/// non-transfer never has one.
model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  /// Always positive, in whole Rial. The direction lives in `type`.
  amount      BigInt
  /// Income: the receiving account. Expense: the paying account.
  /// Transfer: the source account.
  accountId   String
  account     Account         @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  /// Transfers only: the destination account.
  toAccountId String?
  toAccount   Account?        @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  /// Transfers are never categorised; the database enforces that.
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner       Owner
  description String?
  /// When the money actually moved, in UTC. Displayed as Jalali (rule G.5).
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([accountId, date])
  @@index([toAccountId])
  @@index([type, date])
  @@index([owner])
  @@index([categoryId])
  @@map("transactions")
}

/// Whether a category describes money coming in or going out.
///
/// A category belongs to exactly one side. "Salary" is never an expense and
/// "Rent" is never income, and keeping them apart means a transaction form
/// can only ever offer categories that make sense for its type.
enum CategoryKind {
  INCOME
  EXPENSE
}

/// A spending or income category, one level of nesting deep.
///
/// The tree is deliberately shallow: a parent groups, a child classifies.
/// Arbitrary depth would make every report decide how far to roll up, and
/// the roadmap's own examples are two levels. The depth limit and the rule
/// that a child shares its parent's kind are enforced in the service.
///
/// Categories are archived, never deleted. Renaming or retiring one must not
/// touch the transactions already filed under it (rule G.4), which the
/// RESTRICT foreign key on Transaction guarantees.
model Category {
  id        String       @id @default(cuid())
  name      String
  kind      CategoryKind
  /// Null for a top-level category.
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]   @relation("CategoryTree")
  /// Key into the icon map in the UI, not a component or a path.
  icon      String?
  isActive  Boolean      @default(true)
  /// Display order among siblings; ties fall back to the name.
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]

  @@index([kind, isActive])
  @@index([parentId])
  @@map("categories")
}

/// What an asset is.
///
/// Notably absent: cash and bank balances. Money sitting in an account is
/// already counted as a balance, and registering it again as an asset would
/// double it inside net worth — exactly what task 3.9 forbids. Foreign
/// currency belongs here rather than in an Account because the ledger is
/// Rial-only (see the comment on Account.currency).
enum AssetType {
  GOLD
  USD
  EUR
  CAR
  STOCK
  CRYPTO
  PROPERTY
  OTHER
}

/// How an asset's value is arrived at.
///
///   QUANTITY  a holding priced per unit: grams of gold, dollars, shares.
///             Value is quantity × current unit price (task 3.3).
///   FIXED     a single thing with a value of its own: a car, a flat.
///             Quantity is exactly 1, so the same multiplication still holds
///             and every valuation takes one code path (task 3.4).
///
/// Derived from the type rather than chosen by the user — a car is never a
/// per-unit holding — but stored, so the database can enforce the shape of
/// each row instead of trusting whoever wrote it.
enum AssetKind {
  QUANTITY
  FIXED
}

/// Where a recorded value came from.
///
/// Only manual entry exists today. The column is here so that an automatic
/// price feed later cannot be mistaken for something the user typed, and so
/// the opening valuation is distinguishable from a later correction.
enum ValuationSource {
  INITIAL
  MANUAL
}

/// Something the household owns that is not money in an account.
///
/// The row holds what was true at acquisition — how much, of what, bought at
/// what price. What it is worth *now* is deliberately not a column: it lives
/// in AssetValuation, so changing today's price appends a fact instead of
/// overwriting one (rule G.4, task 3.8).
model Asset {
  id       String    @id @default(cuid())
  name     String
  type     AssetType
  kind     AssetKind
  owner    Owner
  /// Scaled by 10^8, the same way money is scaled to Rial: an exact integer
  /// rather than a float, because this number is multiplied by money
  /// (rule G.2, see utils/quantity). FIXED assets hold exactly 100000000.
  quantity BigInt    @default(100000000)
  /// What one unit is, for display: گرم, دلار, سهم. Null for FIXED assets,
  /// which are not counted in units.
  unit     String?
  /// Rial paid per unit at acquisition. For a FIXED asset, quantity is 1, so
  /// this is the purchase value itself (task 3.4).
  purchaseUnitPrice BigInt
  purchaseDate      DateTime
  notes             String?
  /// Archived assets keep their valuation history but leave net worth: the
  /// household no longer owns them. Assets are never deleted (rule G.4).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valuations AssetValuation[]

  @@index([isActive])
  @@index([owner])
  @@index([type])
  @@map("assets")
}

/// What an asset was worth at one instant.
///
/// Rows are appended, never updated. That is the whole mechanism behind task
/// 3.8: re-pricing gold today writes a new row for today, and last month's
/// row still says what last month's portfolio was worth. The net-worth
/// history in task 3.10 reads straight off this table, so it is a record of
/// what actually happened rather than today's price projected backwards.
///
/// `quantity` and `value` are stored rather than recomputed from the asset.
/// Selling half a holding tomorrow must not halve what the portfolio was
/// worth yesterday.
model AssetValuation {
  id      String @id @default(cuid())
  assetId String
  /// Cascade because a valuation has no meaning without its asset. Assets
  /// are archived rather than deleted, so this should never fire.
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Rial per unit at `asOf`.
  unitPrice BigInt
  /// The holding at `asOf`, scaled like Asset.quantity.
  quantity  BigInt
  /// unitPrice × quantity in whole Rial, rounded once, at write time.
  value     BigInt
  /// When this valuation was true, in UTC. Displayed as Jalali (rule G.5).
  asOf      DateTime
  source    ValuationSource @default(MANUAL)
  note      String?
  createdAt DateTime        @default(now())

  /// One valuation per asset per instant: re-pricing the same moment twice
  /// is a correction, not a second data point.
  @@unique([assetId, asOf])
  @@index([assetId, asOf])
  @@map("asset_valuations")
}
